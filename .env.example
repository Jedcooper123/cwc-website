# ─────────────────────────────────────────────────────────────────────────────
# Launchpad site — environment variables.
# Local: copy to .env and run `npm run dev:server` (API) + `npm run dev` (site).
# Production: set each of these in Render → your service → Environment.
# Never commit real values; this repo is public.
# ─────────────────────────────────────────────────────────────────────────────

# ----- REQUIRED -----

# Neon → your project → Connect → "Pooled connection" string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Long random string for signing logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Your admin login. Re-applied on every deploy, so changing it here (in
# Render) is also how you reset a forgotten admin password.
ADMIN_EMAIL=jedpcooper@gmail.com
ADMIN_PASSWORD=

# Public site URL, used in links inside emails.
APP_URL=https://www.launchpadwebconsulting.com

# ----- EMAIL (Resend) -----

# Resend → API Keys. Without it, emails are printed to the server log instead.
RESEND_API_KEY=
# Must use a domain verified in Resend (Resend → Domains).
EMAIL_FROM=Launchpad Web Consulting <hello@launchpadwebconsulting.com>
# Where client requests and website inquiries are sent.
OWNER_NOTIFY_EMAIL=jedpcooper@gmail.com
# Test mode: send EVERY email here instead of to the real recipient.
# REDIRECT_ALL_EMAIL_TO=jedpcooper@gmail.com

# ----- ADS (optional) -----

# Meta Events Manager → your Pixel's ID (numbers only). Not a secret. When set,
# the site sends PageView / Lead / Schedule / Contact events to Meta. It's read
# at build time, so Render needs a redeploy after you add or change it.
# VITE_META_PIXEL_ID=

# Render sets this automatically in production.
# NODE_ENV=production
